# ─── Supabase Configuration ──────────────────────────────────────────────────────
# Get these from your Supabase project: Settings > API
SUPABASE_URL=your_supabase_project_url
SUPABASE_KEY=your_supabase_service_role_key

# ─── Pre-configured Login Credentials ────────────────────────────────────────────
# These credentials are hardcoded in the system for demonstration purposes.
# You do NOT need to set them as environment variables — they are listed here
# for your reference so you can log in and test the application.
