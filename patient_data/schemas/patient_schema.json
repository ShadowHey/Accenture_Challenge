{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Patient Schema",
  "type": "object",
  "properties": {
    "id": { "type": "string" },
    "name": { "type": "string" },
    "age": { "type": "integer" },
    "gender": { "type": "string" },
    "chief_complaint": { "type": "string" },
    "vitals": {
      "type": "object",
      "properties": {
        "heart_rate": { "type": "integer" },
        "blood_pressure": { "type": "string" },
        "systolic_bp": { "type": "integer" },
        "diastolic_bp": { "type": "integer" },
        "respiratory_rate": { "type": "integer" },
        "temperature": { "type": "number" },
        "spo2": { "type": "integer" },
        "gcs": { "type": "integer", "minimum": 3, "maximum": 15 },
        "pain_scale": { "type": "integer", "minimum": 0, "maximum": 10 }
      }
    },
    "history_available": { "type": "boolean" },
    "medical_history": {
      "type": "array",
      "items": { "type": "string" }
    },
    "observed_signs": {
      "type": "array",
      "items": { "type": "string" }
    },
    "arrival_mode": { "type": "string", "enum": ["walk-in", "ambulance", "helicopter"] },
    "symptoms": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "required": ["id", "name", "age", "gender", "chief_complaint", "vitals", "history_available", "medical_history", "observed_signs"]
}
